# Пути данных/моделей сюда добавляет сам DVC (dvc add / dvc repro) —
# в отдельных .gitignore рядом с артефактами. Вручную их прописывать не нужно.
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/
.DS_Store

# MLflow: локальное хранилище экспериментов (не версионируем ни в Git, ни в DVC)
mlflow.db
mlruns/
mlartifacts/

# Артефакты линтера и тестов
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
test-reports/
